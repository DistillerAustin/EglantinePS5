From e736dfde9e45bc3640935e373927814883803d95 Mon Sep 17 00:00:00 2001
Subject: [PATCH] PS5: retain huge BCn array mip trimming after full core refresh

The original PS5-specific patch was based on an older Vulkan renderer.
Rebased on Djihads80/Eglantine e736dfde9e45bc3640935e373927814883803d95; no changes to the upstream core commit.
---
diff --git a/src/video_core/renderer_vulkan/vk_texture_cache.cpp b/src/video_core/renderer_vulkan/vk_texture_cache.cpp
--- a/src/video_core/renderer_vulkan/vk_texture_cache.cpp
+++ b/src/video_core/renderer_vulkan/vk_texture_cache.cpp
@@ -350,16 +350,58 @@
     return device.GetDeviceLocalMemory() < (u64{7} << 30) ? (u64{256} << 20) : (u64{512} << 20);
 }
 
-// The host shape of an image whose decoded copy would not fit in VRAM: a GPU-decoded ASTC array
+// A native BCn 2D array whose mip chain is over 1.5 GiB (title 1's BC6H terrain arrays:
+// 8192x8192x68). Keep only the smaller mip levels so the PS5 Vulkan driver does not need
+// to map zero-filled sparse memory for the entire multi-gigabyte image.
+[[nodiscard]] u64 NativeMipBytes(const ImageInfo& info, u32 skip) {
+    using namespace VideoCore::Surface;
+    const u32 block_width = DefaultBlockWidth(info.format);
+    const u32 block_height = DefaultBlockHeight(info.format);
+    u64 bytes = 0;
+    for (s32 level = static_cast<s32>(skip); level < info.resources.levels; ++level) {
+        const u32 width = (std::max)(info.size.width >> level, 1U);
+        const u32 height = (std::max)(info.size.height >> level, 1U);
+        bytes += u64{(width + block_width - 1) / block_width} *
+                 ((height + block_height - 1) / block_height) * BytesPerBlock(info.format);
+    }
+    return bytes * info.resources.layers;
+}
+
+[[nodiscard]] bool IsHugeBcnArray(const ImageInfo& info) {
+    if (!IsPixelFormatBCn(info.format) || info.type != ImageType::e2D ||
+        info.resources.layers <= 1 || info.num_samples != 1 || info.size.depth != 1) {
+        return false;
+    }
+    return NativeMipBytes(info, 0) > (u64{3} << 29);
+}
+
+// The host shape of an image whose decoded copy would not fit in VRAM: a GPU-decoded ASTC array
 // over 1 GiB as RGBA8 (title 1's 8192x8192x68 ASTC 8x8 virtual textures are 24 GB each) keeps only
 // its mip levels from `level_offset` on, so host mip 0 is guest mip `level_offset`. Normalized
 // coordinates and derivative LOD still address it correctly; explicit LODs sample one level lower.
 [[nodiscard]] ImageInfo TrimmedHostInfo(const Device& device, const ImageInfo& info, u32& level_offset) {
-    level_offset = 0;
-    if (!WillUseAcceleratedAstcDecode(device, info) || info.type != ImageType::e2D) {
-        return info;
-    }
-    const auto decoded_bytes = [&](u32 skip) {
+    level_offset = 0;
+    const bool huge_bcn = IsHugeBcnArray(info);
+    if ((!WillUseAcceleratedAstcDecode(device, info) && !huge_bcn) ||
+        info.type != ImageType::e2D) {
+        return info;
+    }
+    if (huge_bcn) {
+        // Keep at most 1 GiB of native BCn mip levels on the host.
+        while (level_offset + 1 < static_cast<u32>(info.resources.levels) &&
+               NativeMipBytes(info, level_offset) > (u64{1} << 30)) {
+            ++level_offset;
+        }
+        ImageInfo host = info;
+        host.size.width = (std::max)(info.size.width >> level_offset, 1U);
+        host.size.height = (std::max)(info.size.height >> level_offset, 1U);
+        host.resources.levels -= static_cast<s32>(level_offset);
+        LOG_WARNING(Render_Vulkan, "{}x{}x{} BCn array would be {} MiB on the host; keeping mip levels {}+ ({}x{})",
+                    info.size.width, info.size.height, info.resources.layers,
+                    NativeMipBytes(info, 0) >> 20, level_offset, host.size.width, host.size.height);
+        return host;
+    }
+    const auto decoded_bytes = [&](u32 skip) {
         u64 bytes = 0;
         for (s32 level = static_cast<s32>(skip); level < info.resources.levels; ++level) {
             bytes += u64{(std::max)(info.size.width >> level, 1U)} *

diff --git a/src/video_core/texture_cache/texture_cache.h b/src/video_core/texture_cache/texture_cache.h
--- a/src/video_core/texture_cache/texture_cache.h
+++ b/src/video_core/texture_cache/texture_cache.h
@@ -1887,10 +1887,13 @@
             }
         }
         image.dirty_layers.clear();
-        if (layers.empty() || layers.size() == num_layers) {
-            return false;
-        }
-        UploadLayers(image, layers);
+        // A mip-trimmed image must upload only the host levels, even if every layer is dirty.
+        const bool by_layers_only =
+            image.host_level_offset != 0 && False(image.flags & ImageFlagBits::AcceleratedUpload);
+        if (layers.empty() || (layers.size() == num_layers && !by_layers_only)) {
+            return false;
+        }
+        UploadLayers(image, layers);
         return true;
     } else {
         return false;
@@ -1945,8 +1948,15 @@
 void TextureCache<P>::UploadLayers(Image& image, std::span<const u32> layers) {
     if constexpr (requires { &Runtime::AccelerateImageUploadLayers; }) {
         if (False(image.flags & ImageFlagBits::AcceleratedUpload)) {
-            // Plain formats: each layer unswizzled on its own into its layer of the image.
-            ImageInfo layer_info = image.info;
+            // Plain formats: each layer unswizzled on its own into its layer of the image.
+            if (image.host_level_offset != 0 && layers.size() > 3) {
+                // A few layers at a time keeps the staging buffer small.
+                for (size_t first = 0; first < layers.size(); first += 3) {
+                    UploadLayers(image, layers.subspan(first, (std::min<size_t>)(3, layers.size() - first)));
+                }
+                return;
+            }
+            ImageInfo layer_info = image.info;
             layer_info.resources.layers = 1;
             const size_t layer_size = CalculateUnswizzledSizeBytes(layer_info);
             auto staging = runtime.UploadStagingBuffer(layer_size * layers.size());
@@ -1959,8 +1969,12 @@
                 auto layer_copies =
                     UnswizzleImage(*gpu_memory, layer_addr, layer_info, swizzle_data,
                                    staging.mapped_span.subspan(i * layer_size, layer_size));
-                for (BufferImageCopy copy : layer_copies) {
-                    copy.buffer_offset += i * layer_size;
+                for (BufferImageCopy copy : layer_copies) {
+                    if (copy.image_subresource.base_level < static_cast<s32>(image.host_level_offset)) {
+                        continue;
+                    }
+                    copy.image_subresource.base_level -= static_cast<s32>(image.host_level_offset);
+                    copy.buffer_offset += i * layer_size;
                     copy.image_subresource.base_layer = static_cast<s32>(layers[i]);
                     copies.push_back(copy);
                 }
